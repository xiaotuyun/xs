# GEMINI_API_KEY: 官方 Google Gemini API Key
GEMINI_API_KEY=

# CUSTOM_API_KEY: 自定义中转/代理 API Key (兼容 OpenAI / OneAPI 接口格式)
CUSTOM_API_KEY=

# CUSTOM_BASE_URL: 自定义 API 基础地址或中转 Endpoint (如 https://api.openai-proxy.org/v1)
CUSTOM_BASE_URL=

# CUSTOM_LIST_URL: 自定义模型列表获取接口 (可选，如果不填将从 CUSTOM_BASE_URL/models 自动解析)
CUSTOM_LIST_URL=

# DEFAULT_MODEL: 本地部署默认选择的 AI 模型 (如 gemini-2.5-flash, gpt-4o-mini 等)
DEFAULT_MODEL=

# USE_CHAT_COMPLETIONS: 是否默认开启 /chat/completions 兼容模式 (默认: true)
USE_CHAT_COMPLETIONS=true

# PORT: 本地运行或 Cloud Run 服务启动端口 (默认: 3000)
PORT=3000

# APP_URL: 应用托管或部署外部访问域名 (可选)
APP_URL=


